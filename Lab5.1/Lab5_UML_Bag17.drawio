        <mxCell id="30" value="Төлбөрийн adapter нь&#10;Business давхаргад байна.&#10;UI нь DB-д шууд&#10;хандахгүй." style="html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=9;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#526570;text;" vertex="1" parent="1">
